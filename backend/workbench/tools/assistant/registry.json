      "id": "screener_query",
      "domain": "screen",
      "kind": "facade",
      "ns": "screener",
      "method": "query",
      "title": "条件选股",
      "cost": "high",
      "evidence": "筛选",
      "guards": true,
      "description": "按表达式全市场选股（如 $PE_TTM < 15）。昂贵且免注册不可用；默认追加非负守卫（布尔位跳过；商誉/有息负债等零值合法）",
      "params": [
        {
          "name": "where",
          "type": "string",
          "required": true,
          "desc": "XS 表达式，用 && / ||，不要 and/or/not"
        },
        {
          "name": "order",
          "type": "string",
          "required": false,
          "desc": "排序指标，如 $PE_TTM"
        },
        {
          "name": "desc",
          "type": "boolean",
          "required": false,
          "default": true,
          "desc": "排序方向：true=从大到小，false=从小到大（找低估值/低 PE 时设 false）"
        },
        {
          "name": "limit",
          "type": "int",
          "required": false,
          "default": 30,
          "desc": "上限（默认 30）"
        }
      ],
      "target": "screener.query"
