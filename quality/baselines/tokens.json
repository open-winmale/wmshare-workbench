  "_allowed_raw_hex_notes": {
    "_comment": "为什么这两个文件豁免裸色值门禁：canvas 渲染器吃不了 var(--wb-x) 字符串，必须在渲染时用 getComputedStyle 解析成具体色值——解析发生在 chart-theme.ts（cssVar 的 fallback 参数 + 12 色移植调色板），它是唯一合法的「JS 侧色值住址」。其余任何 .ts/.vue 里的裸色值都直接红。",
    "frontend/src/styles/tokens.css": "令牌真源本体，色值定义在这里是它的职责",
    "frontend/src/styles/chart-theme.ts": "ECharts 需要具体色值（canvas 不解析 CSS 变量）；12 色为对标物移植值、顺序不可重排（CVD 相邻对校验）"
  },
  "allowed_raw_hex_files": [
    "frontend/src/styles/tokens.css",
    "frontend/src/styles/chart-theme.ts"
  ],
